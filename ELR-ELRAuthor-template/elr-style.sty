%% =====================================================================
%% FRONT MATTER
%% =====================================================================
\newcommand{\ELRMakeTitle}{%
  \setcounter{page}{\ELR@startpage}%
  \thispagestyle{firstpage}%
  % The copyright/open-access notice is the first, unnumbered item in the
  % standard first-page footnote area. Author footnotes follow as 1, 2, 3...
  \ELRPublicationFootnote

  % --- Original ELR top composition: left information + right logo ---
  \noindent
  \begin{minipage}[c]{0.69\textwidth}
    {\sffamily\fontsize{16.5}{19.4}\selectfont\bfseries\color{ELRBlue}%
      Explorations in Linguistic Review}\par
    \vspace{0.18em}
    {\sffamily\fontsize{9.2}{11.2}\selectfont\itshape\color{ELRGold}%
      \ELRSlogan}\par
    \vspace{0.42em}
    {\sffamily\fontsize{8.5}{10.4}\selectfont
      \ELRSeriesBadge
      {\color{ELRGold}\enspace\textperiodcentered\enspace}
      {\color{ELRBlue}\ELR@year}
      {\color{ELRGold}\enspace\textperiodcentered\enspace}
      {\color{ELRBlue}\ELRIssueDescriptor}
    }\par
    \ELRSpecialIssueLine
    \vspace{0.58em}
    {\fontsize{8.4}{10.4}\selectfont\color{ELRSoft}\raggedright
      \ELR@citationauthor. \ELR@year. \ELR@title.\par
      \textit{Explorations in Linguistic Review} \ELRCitationIssue. \ELR@startpage--\ELR@endpage.\par
      {\color{ELRBlue}\href{https://doi.org/\ELR@doi}{https://doi.org/\ELR@doi}}\par
    }
  \end{minipage}%
  \hfill
  \begin{minipage}[c]{0.29\textwidth}
    \raggedleft
    \ELR@Logo
  \end{minipage}

  \ELRBlueGoldRule
  \vspace{0.78em}

  % --- Article title: clean print composition (no card/frame) ---
  \begin{center}
    {\fontsize{23}{27.5}\selectfont\bfseries\color{ELRDeepBlue}\ELR@title}\par
    \vspace{0.68em}
    \ifELRanonymous
      {\sffamily\normalsize\bfseries\color{ELRBlue}Anonymous Author}\par
    \else
      \ifdefstring{\ELR@series}{ELR}{%
        {\sffamily\fontsize{10.8}{13}\selectfont\bfseries\color{ELRRegularCyanDark}\ELR@author}\par
      }{%
        {\sffamily\fontsize{10.8}{13}\selectfont\bfseries\color{ELRSpecialPurpleDark}\ELR@author}\par
      }
      \vspace{0.08em}
      {\fontsize{9.4}{11.2}\selectfont\color{ELRMuted}\ELR@affiliation}\par
      \vspace{0.04em}
      {\fontsize{8.2}{9.8}\selectfont\color{ELRSoft}\texttt{\ELR@email}}\par
    \fi
  \end{center}

  \vspace{0.50em}

  % --- Compact ELR abstract block ---
  % The abstract stays with the title on the opening page, while the main
  % text continues naturally below it whenever space permits.
  \begin{ELRAbstractBox}
    \noindent
    {\sffamily\fontsize{9.3}{11}\selectfont\bfseries\ELRAccentText{\ELRAbstractLabel}}
    \hspace{0.55em}{\color{ELRGold}\rule{1.55cm}{0.65pt}}\par
    \vspace{0.36em}
    {\fontsize{9.6}{12.2}\selectfont\setlength{\parindent}{0pt}\color{ELRText}\ELR@abstract\par}
    \vspace{0.42em}
    {\color{ELRPaleGold}\hrule height 0.30pt}
    \vspace{0.34em}
    {\sffamily\fontsize{8.7}{10.4}\selectfont
      {\bfseries\ELRAccentText{\ELRKeywordsLabel}}\enspace
      {\color{ELRMuted}\ELR@keywords}}
  \end{ELRAbstractBox}
  \vspace{0.60em}

}

