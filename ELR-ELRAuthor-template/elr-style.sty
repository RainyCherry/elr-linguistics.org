% Modern sans headings; gold numbers, blue titles.
\newcommand{\ELRAccentText}[1]{%
  \ifdefstring{\ELR@series}{ELR}{\color{ELRRegularCyanDark}#1}{\color{ELRSpecialPurpleDark}#1}%
}

\titleformat{\section}
  {\sffamily\fontsize{15.2}{18.2}\selectfont\bfseries\color{ELRBlue}}
  {\ELRAccentText{\thesection}}
  {0.72em}{}
\titlespacing*{\section}{0pt}{1.55em}{0.58em}

\titleformat{\subsection}
  {\sffamily\fontsize{12.4}{14.8}\selectfont\bfseries\color{ELRDeepBlue}}
  {\ELRAccentText{\thesubsection}}
  {0.68em}{}
\titlespacing*{\subsection}{0pt}{1.15em}{0.42em}

\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{ELRMuted}}
  {\ELRAccentText{\thesubsubsection}}
  {0.62em}{}
\titlespacing*{\subsubsection}{0pt}{0.95em}{0.32em}

\captionsetup{
  font=small,
  labelfont={bf,color=ELRBlue},
  textfont={color=ELRText},
  labelsep=period,
  skip=5pt
}

%% ---------------------------------------------------------------------
%% Footnotes -- ELR Linguistic Horizon Gold separator
%% ---------------------------------------------------------------------
% One unified scholarly footnote area is used on every page.
% On page 1, the ELR copyright/open-access notice is inserted as an
% UNNUMBERED publication footnote. Ordinary author footnotes then follow
% naturally underneath it as 1, 2, 3, 4 ...
\setlength{\skip\footins}{10pt plus 2pt minus 2pt}
\renewcommand{\footnoterule}{%
  \kern -3pt
  {\color{ELRGold}\hrule width 0.30\textwidth height 0.45pt}%
  \kern 3.6pt
}

% Slightly cleaner hanging layout for all numbered notes.
\renewcommand\@makefntext[1]{%
  \parindent 0pt
  \noindent
  \hb@xt@1.65em{\hss\@makefnmark\,}#1%
}

% Fixed, unnumbered publication note for the opening page.
% Because this is inserted before any author footnotes, it always appears
% first in the same footnote area; the first author note remains number 1.
\newcommand{\ELRPublicationFootnote}{%
  \begingroup
    \renewcommand{\thefootnote}{}%
    \footnotetext{%
      \fontsize{7.15}{8.65}\selectfont\color{ELRMuted}%
      \textit{Explorations in Linguistic Review} is a peer-reviewed open access journal.
      \textcopyright\ \ELR@year\ The Author(s). This is an open-access article distributed
      under the terms of the Creative Commons Attribution 4.0 International License
      (CC BY 4.0), which permits unrestricted use, distribution, and reproduction in any
      medium, provided the original author and source are credited. See
      \url{https://creativecommons.org/licenses/by/4.0/}.%
    }%
  \endgroup
}

