% Compact issue-family signature used throughout the template.
% Inspired by the ELR cover system: transparent, open frame, circular node.
% Regular ELR uses cyan; HCLT/RCTL/PCP use purple.
\newcommand{\ELRSeriesDisplayCode}{%
  \ifdefstring{\ELR@series}{ELR}{ELR}{\ELR@series-\ELR@issue}%
}

\newcommand{\ELRSeriesBadge}{%
  \begingroup
  \ifdefstring{\ELR@series}{ELR}{\def\ELR@badgecolor{ELRRegularCyan}}{\def\ELR@badgecolor{ELRSpecialPurple}}%
  \tikz[baseline=(badgetext.base)]{%
    % The invisible frame node fixes the geometry.  The visible series code
    % is centred on the visible open-frame geometry (not merely the text node).
    \node[inner xsep=5.8pt,inner ysep=2.2pt,
      font=\sffamily\fontsize{7.5}{8.4}\selectfont\bfseries] (badgeframe)
      {\strut\phantom{\ELRSeriesDisplayCode}};
    \node[inner sep=0pt,text=\ELR@badgecolor,
      font=\sffamily\fontsize{7.5}{8.4}\selectfont\bfseries,
      xshift=-5.5pt] (badgetext) at (badgeframe.center)
      {\strut\ELRSeriesDisplayCode};
    % Open frame: left spine + top/bottom strokes, deliberately no right edge.
    \draw[\ELR@badgecolor,line width=0.55pt,rounded corners=1.6pt]
      ([xshift=-4pt,yshift=1.5pt]badgeframe.north west)
      -- ([xshift=-4pt,yshift=-1.5pt]badgeframe.south west)
      -- ([xshift=-7pt,yshift=-1.5pt]badgeframe.south east);
    \draw[\ELR@badgecolor,line width=0.55pt,rounded corners=1.6pt]
      ([xshift=-4pt,yshift=1.5pt]badgeframe.north west)
      -- ([xshift=-7pt,yshift=1.5pt]badgeframe.north east);
    % Small circular node echoes the cover spine motif.
    \draw[\ELR@badgecolor,line width=0.55pt,fill=white]
      ([xshift=-4pt]badgeframe.west) circle[radius=1.25pt];
  }%
  \endgroup
}

